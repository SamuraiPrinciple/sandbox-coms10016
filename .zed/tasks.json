[
  {
    "label": "C: make $ZED_FILENAME",
    "command": "sh",
    "args": [".vscode/make-current-file.sh", "$ZED_RELATIVE_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Haskell: run $ZED_FILENAME",
    "command": "runghc",
    "args": ["$ZED_FILENAME"],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "GHCi: $ZED_FILENAME",
    "command": "ghci",
    "args": ["$ZED_FILENAME"],
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": true,
    "reveal": "always"
  }
]
